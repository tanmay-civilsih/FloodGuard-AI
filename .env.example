MINIO_ACCESS_KEY=floodguard
MINIO_SECRET_KEY=floodguard_dev_only

# Optional credential references used by registry metadata. Leave blank until authorized.
EARTHDATA_TOKEN=
COPERNICUS_ACCESS_TOKEN=
IMD_RADAR_TOKEN=
KMC_SCADA_TOKEN=
KMC_DRAIN_SENSOR_TOKEN=
