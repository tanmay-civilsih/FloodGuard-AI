# Never place production secrets in this file.
FLOODGUARD_ENVIRONMENT=development
FLOODGUARD_LOG_LEVEL=INFO
FLOODGUARD_API_HOST=0.0.0.0
FLOODGUARD_API_PORT=8000
FLOODGUARD_DATABASE_URL=postgresql+psycopg://floodguard:floodguard_dev_only@localhost:5432/floodguard

POSTGRES_DB=floodguard
