# Never place production secrets in this file.
FLOODGUARD_ENVIRONMENT=development
FLOODGUARD_LOG_LEVEL=INFO
FLOODGUARD_API_HOST=0.0.0.0
FLOODGUARD_API_PORT=8000
FLOODGUARD_DATABASE_URL=postgresql+psycopg://floodguard:floodguard_dev_only@localhost:5432/floodguard

# Local-host object store settings. Docker Compose overrides the endpoint to minio:9000.
FLOODGUARD_OBJECT_STORE_ENDPOINT=localhost:9000
FLOODGUARD_OBJECT_STORE_ACCESS_KEY=floodguard
FLOODGUARD_OBJECT_STORE_SECRET_KEY=floodguard_dev_only
FLOODGUARD_OBJECT_STORE_SECURE=false
FLOODGUARD_RAW_BUCKET=floodguard-raw
FLOODGUARD_SPATIAL_BUCKET=floodguard-spatial
FLOODGUARD_HARVEST_MAX_OBJECT_BYTES=134217728
FLOODGUARD_HARVEST_MAX_TOTAL_BYTES=805306368
FLOODGUARD_HARVEST_MAX_RESOURCES_PER_SOURCE=250
FLOODGUARD_HARVEST_TIMEOUT_SECONDS=60

# Sequence 4 spatial harmonization. EPSG:32645 is WGS 84 / UTM zone 45N for Kolkata.
FLOODGUARD_WORKING_CRS=EPSG:32645
FLOODGUARD_SPATIAL_ALIGNMENT_TOLERANCE_M=0.05
FLOODGUARD_RAINFALL_CONSERVATION_TOLERANCE=0.000000001
FLOODGUARD_SPATIAL_MAX_OBJECT_BYTES=134217728

POSTGRES_DB=floodguard
POSTGRES_USER=floodguard
POSTGRES_PASSWORD=floodguard_dev_only

MINIO_ACCESS_KEY=floodguard
MINIO_SECRET_KEY=floodguard_dev_only

# Optional credential references used by registry metadata. Leave blank until authorized.
EARTHDATA_TOKEN=
COPERNICUS_ACCESS_TOKEN=
IMD_RADAR_TOKEN=
KMC_SCADA_TOKEN=
KMC_DRAIN_SENSOR_TOKEN=

# Mutations are disabled until an operator is configured; reads remain public.
# Run: python scripts/setup_operator.py
# Stores token SHA-256 digests and roles, never plaintext bearer tokens.
FLOODGUARD_OPERATORS_JSON=
