{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-availability-v1",
      "default": "source-availability-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "source_revision": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "format": "date-time",
      "title": "Valid To",
      "type": "string"
    },
    "source_issue_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Issue Time"
    },
    "provider_available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Available At"
    },
    "availability_status": {
      "enum": [
        "VERIFIED",
        "ESTIMATED",
        "UNKNOWN"
      ],
      "title": "Availability Status",
      "type": "string"
    },
    "availability_evidence": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Availability Evidence",
      "type": "string"
    },
    "estimated_latency_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Latency Seconds"
    }
  },
  "required": [
    "source_id",
    "dataset_version_id",
    "source_revision",
    "acquired_at",
    "valid_from",
    "valid_to",
    "availability_status",
    "availability_evidence"
  ],
  "title": "SourceAvailabilityRecord",
  "type": "object"
}
